# Salin ke .env.local lalu isi. JANGAN commit .env.local ke git.

# Supabase project (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here

# Session JWT (gunakan string acak panjang, mis. hasil: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Password awal Panel 1 & Panel 3 (hanya dipakai saat tabel masih kosong)
INITIAL_ADMIN_PASSWORD=
INITIAL_MONITOR_PASSWORD=

# Domain redirect (untuk menampilkan link lengkap member)
REDIRECT_DOMAIN=fumifun.sbs

# Opsional: guard endpoint postback
# POSTBACK_TOKEN=opsional-token-untuk-verifikasi-postback
